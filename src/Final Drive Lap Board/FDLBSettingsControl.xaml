<UserControl x:Class="Final_Drive_Lap_Board.FDLBSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: setup row -->
            <RowDefinition Height="Auto"/>
            <!-- 1: live label -->
            <RowDefinition Height="2*"/>
            <!-- 2: current attempt -->
            <RowDefinition Height="2*"/>
            <!-- 3: lap board -->
            <RowDefinition Height="Auto"/>
            <!-- 4: debug -->
        </Grid.RowDefinitions>


        <!-- Setup: driver, car, track, laps, conditions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Driver:" Margin="0,0,4,0"/>
            <TextBox x:Name="DriverTextBox" Grid.Column="1" Height="22"/>

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Car:" Margin="0,0,4,0"/>
            <ComboBox x:Name="CarComboBox"
                      Grid.Column="4"
                      IsEditable="True"
                      Height="22"/>

            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Track:" Margin="0,0,4,0"/>
            <ComboBox x:Name="TrackComboBox"
                      Grid.Column="7"
                      IsEditable="True"
                      Height="22"/>
            <Button Content="..."
                    Width="25"
                    Click="EditCatalog_Click" Grid.Column="8" Grid.ColumnSpan="2" HorizontalAlignment="Left" ToolTip="Edit cars_tracks.ini"/>
            <Button Content="∞"
                    Width="25"
                    Click="ReloadCatalog_Click" Grid.Column="10" Margin="1,0,75,0" ToolTip="Reload Car and Track dropdowns"/>

            <TextBlock Grid.Column="9" VerticalAlignment="Center" Text="Laps/set:" Margin="40,0,14,0" Grid.ColumnSpan="2"/>
            <TextBox x:Name="LapsPerSetTextBox"
                     Grid.Column="13"
                     Height="22"
                     Width="40"
                     Text="3" HorizontalAlignment="Left"/>

            <TextBlock Grid.Column="12" VerticalAlignment="Center" Text="Conditions:" Margin="56,0,68,0" Grid.ColumnSpan="2"/>
            <ComboBox x:Name="ConditionComboBox"
                      Grid.Column="13"
                      Height="22"
                      SelectedIndex="0" Margin="120,0,-100,0"
                      SelectionChanged="ConditionComboBox_SelectionChanged">
                <ComboBoxItem Content="Dry"/>
                <ComboBoxItem Content="Wet"/>
                <ComboBoxItem Content="Very Wet"/>
                <ComboBoxItem Content="Sleet/Snow"/>
                <ComboBoxItem Content="Fog"/>
            </ComboBox>
        </Grid>

        <!-- Live lap label -->
        <TextBlock Grid.Row="1"
                   x:Name="LiveLapLabel"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <!-- Attempt section -->
        <GroupBox Grid.Row="2" Header="Current attempt" Margin="0,0,0,8" HorizontalAlignment="Stretch">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Laps list -->
                <ListView x:Name="AttemptLapListView"
                          Grid.Row="0"
                          Margin="0,0,0,4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsThreeState="True"
                                          Click="LapValidity_Click"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding DisplayText}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Buttons -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0">
                    <Button Content="START ATTEMPTS"
                            Width="140"
                            Margin="0,0,6,0"
                            Click="StartAttempts_Click"/>

                    <Button Content="ABORT ATTEMPTS"
                            Width="140"
                            Margin="0,0,6,0"
                            Click="AbortAttempts_Click"/>

                    <Button Content="COMMIT VALIDATED"
                            Width="140"
                            Margin="0,0,6,0"
                            Click="CommitAttempts_Click"/>

                    <Button Content="SAVE ATTEMPT TO CSV"
                            Width="140"
                            Click="SaveAttemptCsv_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Lap board -->
        <GroupBox Grid.Row="3" Header="Lap board" HorizontalAlignment="Stretch">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="BoardTextBox"
                         Grid.Row="0"
                         Margin="0,0,0,4"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         AcceptsReturn="True"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="EXPORT BOARD TO CSV"
                            Width="140"
                            Click="ExportBoardCsv_Click"/>

                    <Button Content="RESET BOARD"
                            Width="140"
                            Margin="6,0,0,0"
                            Click="ResetBoard_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Debug (telemetry snapshot) -->
        <GroupBox Grid.Row="4" Header="DEBUG (TELEMETRY)" Margin="0,8,0,0">
            <TextBox x:Name="DebugTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     MinHeight="48"/>
        </GroupBox>
    </Grid>
</UserControl>
